# Copy this file to `.env` and fill in the values.
# Never commit your actual `.env` file — it's in .gitignore.

# ---- Database ----
# MongoDB connection string (Atlas or local replica set with transactions)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"
# Local MongoDB replica set alternative:
# DATABASE_URL="mongodb://localhost:27017/flipzone?replicaSet=rs0"

# ---- Auth.js (NextAuth v5) ----
# Generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth — https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- App URL ----
# Used for self-referential URLs (email links, redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Stripe (test mode) ----
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# For local webhooks: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- Resend (transactional email) ----
# https://resend.com/api-keys — order confirmations; app runs fine without it
RESEND_API_KEY="re_..."

# ---- Sentry (error tracking) — Phase 4 ----
# SENTRY_DSN=""
